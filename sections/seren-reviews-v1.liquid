{% comment %}
  SEREN Reviews Section
  Mobile-first premium testimonial section for Shopify Online Store 2.0 / Dawn.
{% endcomment %}

<section
  class="seren-reviews"
  style="
    --seren-reviews-bg: {{ section.settings.section_bg }};
    --seren-reviews-max-width: {{ section.settings.max_width }}px;
    --seren-reviews-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --seren-reviews-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --seren-reviews-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --seren-reviews-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;

    --seren-reviews-heading-color: {{ section.settings.heading_color }};
    --seren-reviews-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --seren-reviews-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --seren-reviews-heading-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --seren-reviews-heading-max-width: {{ section.settings.heading_max_width }}px;

    --seren-reviews-subheading-color: {{ section.settings.subheading_color }};
    --seren-reviews-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --seren-reviews-subheading-size-desktop: {{ section.settings.subheading_size_desktop }}px;
    --seren-reviews-subheading-max-width: {{ section.settings.subheading_max_width }}px;

    --seren-reviews-card-bg: {{ section.settings.card_bg }};
    --seren-reviews-card-border: {{ section.settings.card_border }};
    --seren-reviews-card-radius: {{ section.settings.card_radius }}px;
    --seren-reviews-card-shadow-opacity: {{ section.settings.card_shadow_opacity | divided_by: 100.0 }};
    --seren-reviews-card-shadow-blur: {{ section.settings.card_shadow_blur }}px;
    --seren-reviews-card-shadow-y: {{ section.settings.card_shadow_y }}px;
    --seren-reviews-card-gap: {{ section.settings.card_gap }}px;

    --seren-reviews-star-color: {{ section.settings.star_color }};
    --seren-reviews-star-size: {{ section.settings.star_size }}px;
    --seren-reviews-text-color: {{ section.settings.review_text_color }};
    --seren-reviews-text-size-mobile: {{ section.settings.review_text_size_mobile }}px;
    --seren-reviews-text-size-desktop: {{ section.settings.review_text_size_desktop }}px;
    --seren-reviews-name-color: {{ section.settings.name_color }};
    --seren-reviews-name-size: {{ section.settings.name_size }}px;
  "
>
  <div class="seren-reviews__inner">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="seren-reviews__header">
        {% if section.settings.heading != blank %}
          <h2 class="seren-reviews__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="seren-reviews__subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="seren-reviews__grid">
      {% for block in section.blocks %}
        <article class="seren-reviews__card" {{ block.shopify_attributes }}>
          <div class="seren-reviews__stars" aria-label="{{ block.settings.stars }} von 5 Sternen">
            {% for i in (1..5) %}
              {% if i <= block.settings.stars %}
                <span aria-hidden="true">★</span>
              {% else %}
                <span class="seren-reviews__star-empty" aria-hidden="true">★</span>
              {% endif %}
            {% endfor %}
          </div>

          {% if block.settings.review_text != blank %}
            <div class="seren-reviews__quote">
              {{ block.settings.review_text }}
            </div>
          {% endif %}

          {% if block.settings.name != blank or block.settings.age != blank %}
            <div class="seren-reviews__author">
              —
              {% if block.settings.name != blank %}
                {{ block.settings.name }}
              {% endif %}
              {% if block.settings.age != blank %}
                <span>, {{ block.settings.age }}</span>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .seren-reviews {
    background: var(--seren-reviews-bg);
    padding-top: var(--seren-reviews-padding-top-mobile);
    padding-bottom: var(--seren-reviews-padding-bottom-mobile);
    overflow: hidden;
  }

  .seren-reviews__inner {
    width: min(100% - 32px, var(--seren-reviews-max-width));
    margin: 0 auto;
  }

  .seren-reviews__header {
    text-align: center;
    margin: 0 auto 34px;
  }

  .seren-reviews__heading {
    max-width: var(--seren-reviews-heading-max-width);
    margin: 0 auto;
    color: var(--seren-reviews-heading-color);
    font-size: var(--seren-reviews-heading-size-mobile);
    line-height: var(--seren-reviews-heading-line-height);
    letter-spacing: -0.035em;
    font-weight: 500;
  }

  .seren-reviews__subheading {
    max-width: var(--seren-reviews-subheading-max-width);
    margin: 16px auto 0;
    color: var(--seren-reviews-subheading-color);
    font-size: var(--seren-reviews-subheading-size-mobile);
    line-height: 1.55;
    font-weight: 400;
  }

  .seren-reviews__subheading p {
    margin: 0;
  }

  .seren-reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--seren-reviews-card-gap);
  }

  .seren-reviews__card {
    background: var(--seren-reviews-card-bg);
    border: 1px solid var(--seren-reviews-card-border);
    border-radius: var(--seren-reviews-card-radius);
    box-shadow: 0 var(--seren-reviews-card-shadow-y) var(--seren-reviews-card-shadow-blur) rgba(38, 25, 18, var(--seren-reviews-card-shadow-opacity));
    padding: 28px 24px;
  }

  .seren-reviews__stars {
    display: flex;
    gap: 5px;
    color: var(--seren-reviews-star-color);
    font-size: var(--seren-reviews-star-size);
    line-height: 1;
    letter-spacing: 0.04em;
    margin-bottom: 20px;
  }

  .seren-reviews__star-empty {
    opacity: 0.22;
  }

  .seren-reviews__quote {
    color: var(--seren-reviews-text-color);
    font-size: var(--seren-reviews-text-size-mobile);
    line-height: 1.18;
    letter-spacing: -0.025em;
    font-weight: 450;
  }

  .seren-reviews__quote p {
    margin: 0;
  }

  .seren-reviews__author {
    margin-top: 20px;
    color: var(--seren-reviews-name-color);
    font-size: var(--seren-reviews-name-size);
    line-height: 1.35;
    font-weight: 400;
  }

  @media screen and (min-width: 750px) {
    .seren-reviews {
      padding-top: var(--seren-reviews-padding-top-desktop);
      padding-bottom: var(--seren-reviews-padding-bottom-desktop);
    }

    .seren-reviews__inner {
      width: min(100% - 64px, var(--seren-reviews-max-width));
    }

    .seren-reviews__header {
      margin-bottom: 48px;
    }

    .seren-reviews__heading {
      font-size: var(--seren-reviews-heading-size-desktop);
    }

    .seren-reviews__subheading {
      font-size: var(--seren-reviews-subheading-size-desktop);
      margin-top: 18px;
    }

    .seren-reviews__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }

    .seren-reviews__card {
      padding: 34px 32px;
      min-height: 100%;
    }

    .seren-reviews__quote {
      font-size: var(--seren-reviews-text-size-desktop);
    }
  }
</style>

