{% schema %}
{
  "name": "SEREN Text + 3 Hochkant-Bilder",
  "tag": "section",
  "class": "seren-three-portrait-images-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "SO FUNKTIONIERT SEREN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "In wenigen Momenten wieder mehr Form im Haar."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Beschreibung",
      "default": "SEREN SoftTouch ist für schnelle Touch-Ups gemacht — genau an den Stellen, die morgens nicht sitzen wollen."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Bild 1"
    },
    {
      "type": "text",
      "id": "image_1_title",
      "label": "Bild 1 Titel",
      "default": "1. Sanft starten"
    },
    {
      "type": "textarea",
      "id": "image_1_text",
      "label": "Bild 1 Text",
      "default": "Niedrige Temperatur wählen — ideal für feines Haar."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Bild 2"
    },
    {
      "type": "text",
      "id": "image_2_title",
      "label": "Bild 2 Titel",
      "default": "2. Gezielt nachformen"
    },
    {
      "type": "textarea",
      "id": "image_2_text",
      "label": "Bild 2 Text",
      "default": "Frizz, Spitzen und platte Partien sanft in Form bringen."
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Bild 3"
    },
    {
      "type": "text",
      "id": "image_3_title",
      "label": "Bild 3 Titel",
      "default": "3. Ruhigeres Finish"
    },
    {
      "type": "textarea",
      "id": "image_3_text",
      "label": "Bild 3 Text",
      "default": "Weniger Frizz, mehr Kontrolle und natürliches Volumen."
    },
    {
      "type": "checkbox",
      "id": "show_card_text",
      "label": "Texte auf den Bild-Kacheln anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Text unter den Bildern",
      "default": "Für feines Haar, Frizz & schnelle Morgen-Touch-Ups."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "SEREN SoftTouch kaufen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrundfarbe",
      "default": "#F7F1EA"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Kachel-Hintergrundfarbe",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#241814"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Beschreibung / kleine Schrift",
      "default": "#7A6A60"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Akzentfarbe",
      "default": "#B88A6A"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximale Breite",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Abstand zwischen Bildern",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Kachel Eckenradius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "SEREN Text + 3 Hochkant-Bilder"
    }
  ]
}
{% endschema %}

<section
  class="seren-three-portrait"
  style="
    --seren-bg: {{ section.settings.background }};
    --seren-card-bg: {{ section.settings.card_background }};
    --seren-text: {{ section.settings.text_color }};
    --seren-muted: {{ section.settings.muted_color }};
    --seren-accent: {{ section.settings.accent_color }};
    --seren-max-width: {{ section.settings.max_width }}px;
    --seren-pt: {{ section.settings.padding_top }}px;
    --seren-pb: {{ section.settings.padding_bottom }}px;
    --seren-radius: {{ section.settings.border_radius }}px;
    --seren-gap: {{ section.settings.image_gap }}px;
  "
>
  <div class="seren-three-portrait__inner">
    <div class="seren-three-portrait__content">
      {% if section.settings.eyebrow != blank %}
        <p class="seren-three-portrait__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="seren-three-portrait__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="seren-three-portrait__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="seren-three-portrait__grid">
      {% assign image_ids = "image_1,image_2,image_3" | split: "," %}
      {% assign title_ids = "image_1_title,image_2_title,image_3_title" | split: "," %}
      {% assign text_ids = "image_1_text,image_2_text,image_3_text" | split: "," %}

      {% for image_id in image_ids %}
        {% assign image = section.settings[image_id] %}
        {% assign title_id = title_ids[forloop.index0] %}
        {% assign text_id = text_ids[forloop.index0] %}
        {% assign card_title = section.settings[title_id] %}
        {% assign card_text = section.settings[text_id] %}

        <article class="seren-three-portrait__card">
          <div class="seren-three-portrait__image-wrap">
            {% if image != blank %}
              {{
                image
                | image_url: width: 1100
                | image_tag:
                  class: 'seren-three-portrait__image',
                  loading: 'lazy',
                  widths: '360, 520, 720, 900, 1100',
                  sizes: '(max-width: 768px) 100vw, 33vw'
              }}
            {% else %}
              <div class="seren-three-portrait__placeholder">
                <span>{{ forloop.index }}. Hochkant-Bild</span>
              </div>
            {% endif %}
          </div>

          {% if section.settings.show_card_text %}
            <div class="seren-three-portrait__card-copy">
              {% if card_title != blank %}
                <h3 class="seren-three-portrait__card-title">{{ card_title }}</h3>
              {% endif %}

              {% if card_text != blank %}
                <p class="seren-three-portrait__card-text">{{ card_text }}</p>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    {% if section.settings.bottom_text != blank or section.settings.button_label != blank %}
      <div class="seren-three-portrait__footer">
        {% if section.settings.bottom_text != blank %}
          <p class="seren-three-portrait__bottom-text">{{ section.settings.bottom_text }}</p>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="seren-three-portrait__button"
            href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}#product-form{% endif %}"
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .seren-three-portrait {
    background: var(--seren-bg);
    color: var(--seren-text);
    padding-top: var(--seren-pt);
    padding-bottom: var(--seren-pb);
  }

  .seren-three-portrait__inner {
    width: min(var(--seren-max-width), calc(100% - 40px));
    margin: 0 auto;
  }

  .seren-three-portrait__content {
    max-width: 860px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .seren-three-portrait__eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--seren-muted);
  }

  .seren-three-portrait__title {
    margin: 0;
    font-size: clamp(32px, 4.2vw, 62px);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.045em;
    color: var(--seren-text);
  }

  .seren-three-portrait__description {
    max-width: 720px;
    margin: 22px auto 0;
    font-size: clamp(16px, 1.25vw, 20px);
    line-height: 1.65;
    color: var(--seren-muted);
  }

  .seren-three-portrait__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--seren-gap);
    align-items: stretch;
  }

  .seren-three-portrait__card {
    overflow: hidden;
    border-radius: var(--seren-radius);
    background: var(--seren-card-bg);
    box-shadow: 0 24px 70px rgba(36, 24, 20, 0.10);
  }

  .seren-three-portrait__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.45);
  }

  .seren-three-portrait__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seren-three-portrait__placeholder {
    width: 100%;
    height: 100%;
    min-height: 420px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(210,190,170,0.28));
    color: var(--seren-muted);
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  .seren-three-portrait__card-copy {
    padding: 24px 24px 26px;
  }

  .seren-three-portrait__card-title {
    margin: 0;
    font-size: clamp(20px, 1.7vw, 28px);
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--seren-text);
  }

  .seren-three-portrait__card-text {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--seren-muted);
  }

  .seren-three-portrait__footer {
    margin-top: 38px;
    text-align: center;
  }

  .seren-three-portrait__bottom-text {
    margin: 0 auto 18px;
    max-width: 620px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--seren-muted);
  }

  .seren-three-portrait__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 30px;
    border-radius: 999px;
    background: var(--seren-text);
    color: #fff;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .seren-three-portrait__button:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  @media screen and (max-width: 980px) {
    .seren-three-portrait__grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 768px) {
    .seren-three-portrait {
      padding-top: calc(var(--seren-pt) * 0.7);
      padding-bottom: calc(var(--seren-pb) * 0.7);
    }

    .seren-three-portrait__inner {
      width: min(100% - 28px, var(--seren-max-width));
    }

    .seren-three-portrait__content {
      margin-bottom: 28px;
      text-align: left;
    }

    .seren-three-portrait__title {
      font-size: clamp(34px, 10vw, 48px);
      line-height: 1.02;
    }

    .seren-three-portrait__description {
      margin-top: 18px;
      font-size: 16px;
      line-height: 1.6;
    }

    .seren-three-portrait__card {
      border-radius: calc(var(--seren-radius) * 0.75);
    }

    .seren-three-portrait__card-copy {
      padding: 20px 20px 22px;
    }

    .seren-three-portrait__footer {
      margin-top: 28px;
    }

    .seren-three-portrait__button {
      width: 100%;
    }
  }
</style>
