{% schema %}
{
  "name": "SEREN 3 Bilder",
  "tag": "section",
  "class": "seren-3-img",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "SO FUNKTIONIERT SEREN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "In wenigen Momenten mehr Form im Haar."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Beschreibung",
      "default": "Schnelle Touch-Ups für Stellen, die morgens nicht sitzen wollen."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Bild 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Bild 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Bild 3"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Text unten",
      "default": "Für feines Haar, Frizz und schnelle Touch-Ups."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "SEREN SoftTouch kaufen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "#F7F1EA"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Kachelhintergrund",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#241814"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Sekundärfarbe",
      "default": "#7A6A60"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max. Breite",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Bildabstand",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "SEREN 3 Bilder"
    }
  ]
}
{% endschema %}

<section
  class="seren-3-img"
  style="
    --s-bg: {{ section.settings.background }};
    --s-card-bg: {{ section.settings.card_background }};
    --s-text: {{ section.settings.text_color }};
    --s-muted: {{ section.settings.muted_color }};
    --s-max: {{ section.settings.max_width }}px;
    --s-pt: {{ section.settings.padding_top }}px;
    --s-pb: {{ section.settings.padding_bottom }}px;
    --s-radius: {{ section.settings.border_radius }}px;
    --s-gap: {{ section.settings.image_gap }}px;
  "
>
  <div class="seren-3-img__inner">
    <div class="seren-3-img__content">
      {% if section.settings.eyebrow != blank %}
        <p class="seren-3-img__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="seren-3-img__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="seren-3-img__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="seren-3-img__grid">
      {% for i in (1..3) %}
        {% capture img_id %}image_{{ i }}{% endcapture %}
        {% assign img = section.settings[img_id] %}

        <article class="seren-3-img__card">
          <div class="seren-3-img__image-wrap">
            {% if img != blank %}
              {{
                img
                | image_url: width: 1100
                | image_tag:
                  class: 'seren-3-img__image',
                  loading: 'lazy',
                  widths: '360, 520, 720, 900, 1100',
                  sizes: '(max-width: 980px) 100vw, 33vw'
              }}
            {% else %}
              <div class="seren-3-img__placeholder">
                <span>{{ i }}. Hochkant-Bild</span>
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.bottom_text != blank or section.settings.button_label != blank %}
      <div class="seren-3-img__footer">
        {% if section.settings.bottom_text != blank %}
          <p>{{ section.settings.bottom_text }}</p>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}#product-form{% endif %}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .seren-3-img {
    background: var(--s-bg);
    color: var(--s-text);
    padding-top: var(--s-pt);
    padding-bottom: var(--s-pb);
  }

  .seren-3-img__inner {
    width: min(var(--s-max), calc(100% - 40px));
    margin: 0 auto;
  }

  .seren-3-img__content {
    max-width: 860px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .seren-3-img__eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--s-muted);
  }

  .seren-3-img__title {
    margin: 0;
    font-size: clamp(32px, 4.2vw, 62px);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.045em;
    color: var(--s-text);
  }

  .seren-3-img__description {
    max-width: 720px;
    margin: 22px auto 0;
    font-size: clamp(16px, 1.25vw, 20px);
    line-height: 1.65;
    color: var(--s-muted);
  }

  .seren-3-img__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-gap);
    align-items: stretch;
  }

  .seren-3-img__card {
    overflow: hidden;
    border-radius: var(--s-radius);
    background: var(--s-card-bg);
    box-shadow: 0 24px 70px rgba(36, 24, 20, 0.10);
  }

  .seren-3-img__image-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.45);
  }

  .seren-3-img__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seren-3-img__placeholder {
    width: 100%;
    height: 100%;
    min-height: 420px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(255,255,255,0.78), rgba(210,190,170,0.28));
    color: var(--s-muted);
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  .seren-3-img__footer {
    margin-top: 38px;
    text-align: center;
  }

  .seren-3-img__footer p {
    margin: 0 auto 18px;
    max-width: 620px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--s-muted);
  }

  .seren-3-img__footer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 30px;
    border-radius: 999px;
    background: var(--s-text);
    color: #fff;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
  }

  @media screen and (max-width: 980px) {
    .seren-3-img__grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 768px) {
    .seren-3-img {
      padding-top: calc(var(--s-pt) * 0.7);
      padding-bottom: calc(var(--s-pb) * 0.7);
    }

    .seren-3-img__inner {
      width: min(100% - 28px, var(--s-max));
    }

    .seren-3-img__content {
      margin-bottom: 28px;
      text-align: left;
    }

    .seren-3-img__title {
      font-size: clamp(34px, 10vw, 48px);
      line-height: 1.02;
    }

    .seren-3-img__description {
      margin-top: 18px;
      font-size: 16px;
      line-height: 1.6;
    }

    .seren-3-img__card {
      border-radius: calc(var(--s-radius) * 0.75);
    }

    .seren-3-img__footer {
      margin-top: 28px;
    }

    .seren-3-img__footer a {
      width: 100%;
    }
  }
</style>
