          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Für welche Frisuren ist SEREN ideal?",
            "answer": "<p>Besonders praktisch ist SEREN für Bob, Lob, mittellanges Haar, Spitzen, Seitenpartien und sichtbaren Frizz.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Kann ich SEREN unterwegs nutzen?",
            "answer": "<p>Ja. Durch das kabellose Format eignet sich SEREN auch für schnelle Touch-Ups unterwegs oder auf Reisen.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Auf trockenem oder nassem Haar anwenden?",
            "answer": "<p>Am besten auf trockenem Haar verwenden. Nicht auf nassem Haar anwenden, sofern die Produktanleitung nichts anderes sagt.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Für welche Probleme ist SEREN gedacht?",
            "answer": "<p>Für sichtbaren Frizz, platte Partien, unruhige Spitzen und kleine Haarstellen, die morgens einfach nicht sitzen wollen.</p>"
          }
        }
