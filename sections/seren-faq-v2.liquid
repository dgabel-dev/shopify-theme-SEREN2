{% comment %}
  SEREN FAQ V1
  Premium mobile-first FAQ section for Shopify Online Store 2.0 / Dawn.
  Layout: Title above, then 40/60 image box + FAQ box. No button.
{% endcomment %}

<section
  class="seren-faq"
  style="
    --seren-faq-bg: {{ section.settings.background_color }};
    --seren-faq-text: {{ section.settings.text_color }};
    --seren-faq-muted: {{ section.settings.muted_text_color }};
    --seren-faq-card-bg: {{ section.settings.card_background }};
    --seren-faq-card-border: {{ section.settings.card_border_color }};
    --seren-faq-accent: {{ section.settings.accent_color }};
    --seren-faq-number-bg: {{ section.settings.number_background }};
    --seren-faq-number-text: {{ section.settings.number_text_color }};
    --seren-faq-radius: {{ section.settings.card_border_radius }}px;
    --seren-faq-image-radius: {{ section.settings.image_border_radius }}px;
    --seren-faq-max-width: {{ section.settings.max_width }}px;
    --seren-faq-gap: {{ section.settings.column_gap }}px;

    --seren-faq-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --seren-faq-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --seren-faq-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --seren-faq-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;

    --seren-faq-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --seren-faq-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --seren-faq-heading-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --seren-faq-heading-max-width: {{ section.settings.heading_max_width }}px;

    --seren-faq-question-size-mobile: {{ section.settings.question_size_mobile }}px;
    --seren-faq-question-size-desktop: {{ section.settings.question_size_desktop }}px;
    --seren-faq-answer-size: {{ section.settings.answer_size }}px;
    --seren-faq-image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --seren-faq-image-height-desktop: {{ section.settings.image_height_desktop }}px;
  "
>
  <div class="seren-faq__inner">
    {% if section.settings.heading != blank %}
      <div class="seren-faq__header">
        <h2 class="seren-faq__heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="seren-faq__layout">
      <div class="seren-faq__image-card">
        {% if section.settings.image != blank %}
          <img
            class="seren-faq__image"
            src="{{ section.settings.image | image_url: width: 1000 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 800 }} 800w,
              {{ section.settings.image | image_url: width: 1000 }} 1000w,
              {{ section.settings.image | image_url: width: 1400 }} 1400w
            "
            sizes="(max-width: 749px) 100vw, 40vw"
            alt="{{ section.settings.image_alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {% else %}
          <div class="seren-faq__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'seren-faq__placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <div class="seren-faq__items" data-seren-faq>
        {% for block in section.blocks %}
          <details class="seren-faq__item" {{ block.shopify_attributes }}>
            <summary class="seren-faq__summary">
              <span class="seren-faq__number">
                {{ forloop.index }}
              </span>

              <span class="seren-faq__question">
                {{ block.settings.question }}
              </span>

              <span class="seren-faq__plus" aria-hidden="true"></span>
            </summary>

            {% if block.settings.answer != blank %}
              <div class="seren-faq__answer">
                {{ block.settings.answer }}
              </div>
            {% endif %}
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .seren-faq {
    background: var(--seren-faq-bg);
    color: var(--seren-faq-text);
    padding-top: var(--seren-faq-padding-top-mobile);
    padding-bottom: var(--seren-faq-padding-bottom-mobile);
    overflow: hidden;
  }

  .seren-faq__inner {
    width: min(100% - 32px, var(--seren-faq-max-width));
    margin: 0 auto;
  }

  .seren-faq__header {
    text-align: {{ section.settings.heading_alignment_mobile }};
    margin: 0 0 34px;
  }

  .seren-faq__heading {
    max-width: var(--seren-faq-heading-max-width);
    margin: 0;
    color: var(--seren-faq-text);
    font-size: var(--seren-faq-heading-size-mobile);
    line-height: var(--seren-faq-heading-line-height);
    letter-spacing: -0.045em;
    font-weight: 500;
  }

  .seren-faq__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: stretch;
  }

  .seren-faq__image-card {
    background: var(--seren-faq-card-bg);
    border: 1px solid var(--seren-faq-card-border);
    border-radius: var(--seren-faq-radius);
    overflow: hidden;
    min-height: var(--seren-faq-image-height-mobile);
  }

  .seren-faq__image {
    width: 100%;
    height: var(--seren-faq-image-height-mobile);
    display: block;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    border-radius: var(--seren-faq-image-radius);
  }

  .seren-faq__placeholder {
    width: 100%;
    height: var(--seren-faq-image-height-mobile);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.42);
  }

  .seren-faq__placeholder-svg {
    width: 54%;
    height: auto;
    opacity: 0.35;
  }

  .seren-faq__items {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_gap }}px;
  }

  .seren-faq__item {
    background: var(--seren-faq-card-bg);
    border: 1px solid var(--seren-faq-card-border);
    border-radius: var(--seren-faq-radius);
    overflow: hidden;
  }

  .seren-faq__summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    min-height: {{ section.settings.item_min_height }}px;
    padding: 16px 18px;
  }

  .seren-faq__summary::-webkit-details-marker {
    display: none;
  }

  .seren-faq__number {
    width: {{ section.settings.number_size }}px;
    height: {{ section.settings.number_size }}px;
    border-radius: 999px;
    background: var(--seren-faq-number-bg);
    color: var(--seren-faq-number-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.number_font_size }}px;
    line-height: 1;
    flex-shrink: 0;
  }

  .seren-faq__question {
    color: var(--seren-faq-text);
    font-size: var(--seren-faq-question-size-mobile);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 500;
  }

  .seren-faq__plus {
    position: relative;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--seren-faq-accent);
  }

  .seren-faq__plus::before,
  .seren-faq__plus::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .seren-faq__plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .seren-faq__item[open] .seren-faq__plus::after {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .seren-faq__answer {
    padding: 0 22px 22px calc(18px + {{ section.settings.number_size }}px + 18px);
    color: var(--seren-faq-muted);
    font-size: var(--seren-faq-answer-size);
    line-height: 1.55;
  }

  .seren-faq__answer p {
    margin-top: 0;
    margin-bottom: 10px;
  }

  .seren-faq__answer p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 520px) {
    .seren-faq__summary {
      gap: 12px;
      padding: 14px;
    }

    .seren-faq__answer {
      padding: 0 16px 18px 16px;
    }
  }

  @media screen and (min-width: 750px) {
    .seren-faq {
      padding-top: var(--seren-faq-padding-top-desktop);
      padding-bottom: var(--seren-faq-padding-bottom-desktop);
    }

    .seren-faq__inner {
      width: min(100% - 64px, var(--seren-faq-max-width));
    }

    .seren-faq__header {
      text-align: {{ section.settings.heading_alignment_desktop }};
      margin-bottom: 46px;
    }

    .seren-faq__heading {
      font-size: var(--seren-faq-heading-size-desktop);
      {% if section.settings.heading_alignment_desktop == 'center' %}
        margin-left: auto;
        margin-right: auto;
      {% endif %}
    }

    .seren-faq__layout {
      grid-template-columns: 40fr 60fr;
      gap: var(--seren-faq-gap);
    }

    .seren-faq__image-card,
    .seren-faq__image,
    .seren-faq__placeholder {
      min-height: var(--seren-faq-image-height-desktop);
      height: 100%;
    }

    .seren-faq__image {
      height: 100%;
    }

    .seren-faq__question {
      font-size: var(--seren-faq-question-size-desktop);
    }

    .seren-faq__summary {
      padding: 18px 26px;
    }

    .seren-faq__answer {
      padding-right: 26px;
      padding-bottom: 24px;
      padding-left: calc(26px + {{ section.settings.number_size }}px + 18px);
    }
  }
</style>

{% schema %}
{
  "name": "SEREN FAQ V2",
  "tag": "section",
  "class": "section-seren-faq",
  "settings": [
    {
      "type": "header",
