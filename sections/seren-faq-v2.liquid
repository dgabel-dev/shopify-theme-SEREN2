          "type": "faq_item",
          "settings": {
            "question": "Ist SEREN ein Glätteisen?",
            "answer": "<p>Nein. SEREN ist kein klassisches Glätteisen, sondern ein Soft-Heat Touch-Up Comb für sanftes Nachformen kleiner Haarpartien.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Macht SEREN mein Haar platt?",
