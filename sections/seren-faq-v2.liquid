  "max_blocks": 10,
  "presets": [
    {
      "name": "SEREN FAQ V2",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Ist SEREN SoftTouch für feines Haar geeignet?",
            "answer": "<p>Ja. SEREN SoftTouch ist besonders für schnelle Touch-Ups bei feinerem Haar, Frizz und kleinen Partien gedacht, die morgens nicht richtig sitzen.</p>"
          }
