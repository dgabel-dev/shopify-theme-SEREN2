{% comment %}
  SEREN 3 Bilder Full Image V3
  Drei hochkante Bilder nebeneinander, jedes Bild in voller Größe sichtbar.
  Mit editierbaren Text-Einstellungen.
  Shopify Online Store 2.0 / Dawn kompatibel.
{% endcomment %}

<section
  class="seren-3-img"
  style="
    --s-bg: {{ section.settings.background_color }};
    --s-text: {{ section.settings.text_color }};
    --s-muted: {{ section.settings.muted_color }};
    --s-card-bg: {{ section.settings.card_background }};
    --s-card-border: {{ section.settings.card_border_color }};
    --s-radius: {{ section.settings.image_radius }}px;
    --s-card-radius: {{ section.settings.card_radius }}px;
    --s-max-width: {{ section.settings.max_width }}px;
    --s-gap: {{ section.settings.image_gap }}px;

    --s-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --s-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --s-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --s-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;

    --s-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --s-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --s-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --s-description-size-mobile: {{ section.settings.description_size_mobile }}px;
    --s-description-size-desktop: {{ section.settings.description_size_desktop }}px;
    --s-card-title-size: {{ section.settings.card_title_size }}px;
    --s-card-text-size: {{ section.settings.card_text_size }}px;
    --s-bottom-text-size: {{ section.settings.bottom_text_size }}px;

    --s-eyebrow-color: {{ section.settings.eyebrow_color }};
    --s-title-color: {{ section.settings.title_color }};
    --s-description-color: {{ section.settings.description_color }};
    --s-card-title-color: {{ section.settings.card_title_color }};
    --s-card-text-color: {{ section.settings.card_text_color }};
    --s-bottom-text-color: {{ section.settings.bottom_text_color }};

    --s-shadow-opacity: {{ section.settings.shadow_opacity | divided_by: 100.0 }};
    --s-shadow-blur: {{ section.settings.shadow_blur }}px;
    --s-shadow-y: {{ section.settings.shadow_y }}px;
  "
>
  <div class="seren-3-img__inner">
    {% if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.description != blank %}
      <div class="seren-3-img__header seren-3-img__header--{{ section.settings.header_alignment }}">
        {% if section.settings.eyebrow != blank %}
          <p class="seren-3-img__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.title != blank %}
          <h2 class="seren-3-img__title">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="seren-3-img__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="seren-3-img__grid">
      {% for block in section.blocks %}
        <article class="seren-3-img__card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              class="seren-3-img__image"
              src="{{ block.settings.image | image_url: width: 900 }}"
              srcset="
                {{ block.settings.image | image_url: width: 450 }} 450w,
                {{ block.settings.image | image_url: width: 700 }} 700w,
                {{ block.settings.image | image_url: width: 900 }} 900w,
                {{ block.settings.image | image_url: width: 1200 }} 1200w
              "
              sizes="(max-width: 749px) 100vw, 33vw"
              alt="{{ block.settings.image_alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            <div class="seren-3-img__placeholder">
              {{ 'image' | placeholder_svg_tag: 'seren-3-img__placeholder-svg' }}
            </div>
          {% endif %}

          {% if block.settings.card_title != blank or block.settings.card_text != blank %}
            <div class="seren-3-img__copy seren-3-img__copy--{{ section.settings.card_text_alignment }}">
              {% if block.settings.card_title != blank %}
                <h3>{{ block.settings.card_title }}</h3>
              {% endif %}

              {% if block.settings.card_text != blank %}
                <div>{{ block.settings.card_text }}</div>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    {% if section.settings.bottom_text != blank %}
      <div class="seren-3-img__footer seren-3-img__footer--{{ section.settings.header_alignment }}">
        {{ section.settings.bottom_text }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .seren-3-img {
    background: var(--s-bg);
    padding-top: var(--s-padding-top-mobile);
    padding-bottom: var(--s-padding-bottom-mobile);
    overflow: hidden;
  }

  .seren-3-img__inner {
    width: min(100% - 32px, var(--s-max-width));
    margin: 0 auto;
  }

  .seren-3-img__header {
    margin: 0 auto 34px;
  }

  .seren-3-img__header--center {
    text-align: center;
  }

  .seren-3-img__header--left {
    text-align: left;
  }

  .seren-3-img__eyebrow {
    margin: 0 0 14px;
    font-size: var(--s-eyebrow-size);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--s-eyebrow-color);
  }

  .seren-3-img__title {
    max-width: 920px;
    margin: 0;
    font-size: var(--s-title-size-mobile);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.045em;
    color: var(--s-title-color);
  }

  .seren-3-img__header--center .seren-3-img__title {
    margin-left: auto;
    margin-right: auto;
  }

  .seren-3-img__title em {
    font-style: italic;
    font-weight: 400;
  }

  .seren-3-img__description {
    max-width: 720px;
    margin: 22px 0 0;
    font-size: var(--s-description-size-mobile);
    line-height: 1.65;
    color: var(--s-description-color);
  }

  .seren-3-img__header--center .seren-3-img__description {
    margin-left: auto;
    margin-right: auto;
  }

  .seren-3-img__description p,
  .seren-3-img__copy p,
  .seren-3-img__footer p {
    margin: 0;
  }

  .seren-3-img__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-gap);
  }

  .seren-3-img__card {
    background: var(--s-card-bg);
    border: 1px solid var(--s-card-border);
    border-radius: var(--s-card-radius);
    box-shadow: 0 var(--s-shadow-y) var(--s-shadow-blur) rgba(45, 28, 18, var(--s-shadow-opacity));
    overflow: hidden;
  }

  .seren-3-img__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--s-radius);
  }

  .seren-3-img__placeholder {
    aspect-ratio: 9 / 16;
    width: 100%;
    background: rgba(255, 255, 255, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .seren-3-img__placeholder-svg {
    width: 48%;
    height: auto;
    opacity: 0.34;
  }

  .seren-3-img__copy {
    padding: {{ section.settings.card_padding }}px;
  }

  .seren-3-img__copy--center {
    text-align: center;
  }

  .seren-3-img__copy--left {
    text-align: left;
  }

  .seren-3-img__copy h3 {
    margin: 0;
    font-size: var(--s-card-title-size);
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--s-card-title-color);
  }

  .seren-3-img__copy div {
    margin-top: 12px;
    font-size: var(--s-card-text-size);
    line-height: 1.55;
    color: var(--s-card-text-color);
  }

  .seren-3-img__footer {
    max-width: 720px;
    margin: 34px auto 0;
    font-size: var(--s-bottom-text-size);
    line-height: 1.55;
    color: var(--s-bottom-text-color);
  }

  .seren-3-img__footer--center {
    text-align: center;
  }

  .seren-3-img__footer--left {
    text-align: left;
    margin-left: 0;
  }

  @media screen and (min-width: 750px) {
    .seren-3-img {
      padding-top: var(--s-padding-top-desktop);
      padding-bottom: var(--s-padding-bottom-desktop);
    }

    .seren-3-img__inner {
      width: min(100% - 64px, var(--s-max-width));
    }

    .seren-3-img__header {
      margin-bottom: 46px;
    }

    .seren-3-img__title {
      font-size: var(--s-title-size-desktop);
    }

    .seren-3-img__description {
      font-size: var(--s-description-size-desktop);
    }

    .seren-3-img__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>

{% schema %}
{
  "name": "SEREN Bilder V3",
  "tag": "section",
  "class": "section-seren-3-bilder-full-image",
  "settings": [
    {
      "type": "header",
      "content": "Section Inhalt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "SEREN SoftTouch"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Titel",
      "default": "Drei einfache Momente für ein gepflegteres Finish."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschreibung",
      "default": "<p>Sanft nachformen, kleine Partien beruhigen und morgens schneller fertig werden.</p>"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Text unten optional",
      "default": "<p>Nicht neu stylen. Nur sanft nachformen.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Ausrichtung",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Text Farben"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Kleine Überschrift Farbe",
      "default": "#7A6A60"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titel Farbe",
      "default": "#241814"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Beschreibung Farbe",
      "default": "#7A6A60"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Kachel Titel Farbe",
      "default": "#241814"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Kachel Text Farbe",
      "default": "#7A6A60"
    },
    {
      "type": "color",
      "id": "bottom_text_color",
      "label": "Text unten Farbe",
      "default": "#7A6A60"
    },
    {
      "type": "header",
      "content": "Text Größen"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Kleine Überschrift Größe",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Titelgröße Mobile",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Titelgröße Desktop",
      "min": 36,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 62
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Beschreibung Größe Mobile",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_size_desktop",
      "label": "Beschreibung Größe Desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Kachel Titelgröße",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Kachel Textgröße",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "bottom_text_size",
      "label": "Text unten Größe",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Farben & Kacheln"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Hintergrund",
      "default": "#F7F1E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Standard Textfarbe",
      "default": "#241814"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Sekundärfarbe",
      "default": "#7A6A60"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Kachel Hintergrund",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Kachel Border Farbe",
      "default": "#E7D9CB"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Bild Border Radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Kachel Border Radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Kachel Text Padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Kachel Textausrichtung",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Shadow"
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow Stärke",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "%",
      "default": 5
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "Shadow Blur",
      "min": 0,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "shadow_y",
      "label": "Shadow Abstand",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout & Abstände"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Abstand zwischen Bildern",
      "min": 8,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding oben Mobile",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding unten Mobile",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding oben Desktop",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding unten Desktop",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Bild-Kachel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Bild Alt Text",
          "default": "SEREN Bild"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Kachel Titel",
          "default": "Sanftes Touch-Up"
        },
        {
          "type": "richtext",
          "id": "card_text",
          "label": "Kachel Text",
          "default": "<p>Für kleine Partien, die morgens nicht sitzen wollen.</p>"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "SEREN Bilder V3",
      "blocks": [
        {
          "type": "image_card",
          "settings": {
            "card_title": "1. Einschalten",
            "card_text": "<p>Sanfte Wärme in kurzer Zeit bereit.</p>"
          }
        },
        {
          "type": "image_card",
          "settings": {
            "card_title": "2. Nachformen",
            "card_text": "<p>Sanft durch Frizz, Spitzen oder platte Partien führen.</p>"
          }
        },
        {
          "type": "image_card",
          "settings": {
            "card_title": "3. Fertig",
            "card_text": "<p>Ruhigeres Haar — ohne komplettes Styling.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
