{% comment %}
  SEREN Steps Section V1
  Premium mobile-first 3-step image section for Shopify Online Store 2.0 / Dawn.
  No button included.
{% endcomment %}

<section
  class="seren-steps"
  style="
    --seren-steps-bg: {{ section.settings.background_color }};
    --seren-steps-text: {{ section.settings.text_color }};
    --seren-steps-muted: {{ section.settings.muted_text_color }};
    --seren-steps-card-bg: {{ section.settings.card_background }};
    --seren-steps-card-border: {{ section.settings.card_border_color }};
    --seren-steps-card-radius: {{ section.settings.card_border_radius }}px;
    --seren-steps-image-radius: {{ section.settings.image_border_radius }}px;
    --seren-steps-shadow-opacity: {{ section.settings.card_shadow_opacity | divided_by: 100.0 }};
    --seren-steps-shadow-blur: {{ section.settings.card_shadow_blur }}px;
    --seren-steps-shadow-y: {{ section.settings.card_shadow_y }}px;
    --seren-steps-max-width: {{ section.settings.max_width }}px;
    --seren-steps-gap: {{ section.settings.card_gap }}px;
    --seren-steps-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --seren-steps-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --seren-steps-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --seren-steps-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --seren-steps-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --seren-steps-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --seren-steps-heading-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --seren-steps-heading-max-width: {{ section.settings.heading_max_width }}px;
    --seren-steps-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --seren-steps-text-size-desktop: {{ section.settings.text_size_desktop }}px;
    --seren-steps-text-max-width: {{ section.settings.text_max_width }}px;
    --seren-steps-card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
    --seren-steps-card-title-size-desktop: {{ section.settings.card_title_size_desktop }}px;
    --seren-steps-card-text-size-mobile: {{ section.settings.card_text_size_mobile }}px;
    --seren-steps-card-text-size-desktop: {{ section.settings.card_text_size_desktop }}px;
    --seren-steps-image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --seren-steps-image-height-desktop: {{ section.settings.image_height_desktop }}px;
  "
>
  <div class="seren-steps__inner">
    <div class="seren-steps__header">
      {% if section.settings.heading != blank %}
        <h2 class="seren-steps__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="seren-steps__text">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="seren-steps__grid">
        {% for block in section.blocks %}
          <article class="seren-steps__card" {{ block.shopify_attributes }}>
            <div class="seren-steps__card-content">
              {% if block.settings.title != blank %}
                <h3 class="seren-steps__card-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="seren-steps__card-text">
                  {{ block.settings.description }}
                </div>
              {% endif %}
            </div>

            <div class="seren-steps__image-wrap">
              {% if block.settings.image != blank %}
                <img
                  class="seren-steps__image"
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 500 }} 500w,
                    {{ block.settings.image | image_url: width: 700 }} 700w,
                    {{ block.settings.image | image_url: width: 900 }} 900w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(max-width: 749px) 100vw, 33vw"
                  alt="{{ block.settings.image_alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% else %}
                <div class="seren-steps__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'seren-steps__placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .seren-steps {
    background: var(--seren-steps-bg);
    color: var(--seren-steps-text);
    padding-top: var(--seren-steps-padding-top-mobile);
    padding-bottom: var(--seren-steps-padding-bottom-mobile);
    overflow: hidden;
  }

  .seren-steps__inner {
    width: min(100% - 32px, var(--seren-steps-max-width));
    margin: 0 auto;
  }

  .seren-steps__header {
    text-align: center;
    margin: 0 auto 34px;
  }

  .seren-steps__heading {
    max-width: var(--seren-steps-heading-max-width);
    margin: 0 auto;
    color: var(--seren-steps-text);
    font-size: var(--seren-steps-heading-size-mobile);
    line-height: var(--seren-steps-heading-line-height);
    letter-spacing: -0.04em;
    font-weight: 500;
  }

  .seren-steps__heading em {
    font-style: italic;
    font-weight: 400;
  }

  .seren-steps__text {
    max-width: var(--seren-steps-text-max-width);
    margin: 16px auto 0;
    color: var(--seren-steps-muted);
    font-size: var(--seren-steps-text-size-mobile);
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  .seren-steps__text p,
  .seren-steps__card-text p {
    margin: 0;
  }

  .seren-steps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--seren-steps-gap);
  }

  .seren-steps__card {
    background: var(--seren-steps-card-bg);
    border: 1px solid var(--seren-steps-card-border);
    border-radius: var(--seren-steps-card-radius);
    box-shadow: 0 var(--seren-steps-shadow-y) var(--seren-steps-shadow-blur) rgba(45, 28, 18, var(--seren-steps-shadow-opacity));
    overflow: hidden;
  }

  .seren-steps__card-content {
    text-align: center;
    padding: 24px 22px 20px;
  }

  .seren-steps__card-title {
    margin: 0;
    color: var(--seren-steps-text);
    font-size: var(--seren-steps-card-title-size-mobile);
    line-height: 1.16;
    letter-spacing: -0.025em;
    font-weight: 550;
  }

  .seren-steps__card-text {
    margin-top: 10px;
    color: var(--seren-steps-muted);
    font-size: var(--seren-steps-card-text-size-mobile);
    line-height: 1.45;
  }

  .seren-steps__image-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: var(--seren-steps-image-radius);
  }

  .seren-steps__image {
    display: block;
    width: 100%;
    height: var(--seren-steps-image-height-mobile);
    object-fit: cover;
    object-position: center center;
  }

  .seren-steps__placeholder {
    height: var(--seren-steps-image-height-mobile);
    background: rgba(255, 255, 255, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .seren-steps__placeholder-svg {
    width: 45%;
    height: auto;
    opacity: 0.32;
  }

  @media screen and (min-width: 750px) {
    .seren-steps {
      padding-top: var(--seren-steps-padding-top-desktop);
      padding-bottom: var(--seren-steps-padding-bottom-desktop);
    }

    .seren-steps__inner {
      width: min(100% - 64px, var(--seren-steps-max-width));
    }

    .seren-steps__header {
      margin-bottom: 44px;
    }

    .seren-steps__heading {
      font-size: var(--seren-steps-heading-size-desktop);
    }

    .seren-steps__text {
      margin-top: 20px;
      font-size: var(--seren-steps-text-size-desktop);
    }

    .seren-steps__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }

    .seren-steps__card {
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .seren-steps__card-content {
      padding: 28px 28px 24px;
    }

    .seren-steps__card-title {
      font-size: var(--seren-steps-card-title-size-desktop);
    }

    .seren-steps__card-text {
      font-size: var(--seren-steps-card-text-size-desktop);
    }

    .seren-steps__image-wrap {
      margin-top: auto;
    }

    .seren-steps__image {
      height: var(--seren-steps-image-height-desktop);
    }

    .seren-steps__placeholder {
      height: var(--seren-steps-image-height-desktop);
    }
  }
</style>

{% schema %}
{
  "name": "SEREN Steps V1",
  "tag": "section",
  "class": "section-seren-steps",
  "settings": [
    {
      "type": "header",
      "content": "Section Inhalt"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Headline",
      "default": "<p>In wenigen Momenten<br>wieder mehr Form im Haar.</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Beschreibung",
      "default": "<p>SEREN SoftTouch ist für schnelle Touch-Ups gemacht — genau an den Stellen, die morgens nicht sitzen wollen.</p>"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#F7F1E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#2B1D18"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Beschreibung Farbe",
      "default": "#6D5B52"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Kachel Hintergrund",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Kachel Border Farbe",
      "default": "#E7D9CB"
    },
    {
      "type": "header",
      "content": "Headline & Beschreibung"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Headline Größe Mobile",
      "min": 28,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Headline Größe Desktop",
      "min": 46,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Headline Zeilenhöhe",
      "min": 90,
      "max": 140,
      "step": 1,
      "unit": "%",
      "default": 108
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Headline maximale Breite",
      "min": 520,
      "max": 1300,
      "step": 20,
      "unit": "px",
      "default": 980
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Beschreibung Größe Mobile",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Beschreibung Größe Desktop",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Beschreibung maximale Breite",
      "min": 420,
      "max": 980,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "header",
      "content": "Kacheln"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Kachel Border Radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Bild Border Radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_shadow_opacity",
      "label": "Kachel Shadow Stärke",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "%",
      "default": 6
    },
    {
      "type": "range",
      "id": "card_shadow_blur",
      "label": "Shadow Blur",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_shadow_y",
      "label": "Shadow Abstand",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Abstand zwischen Kacheln",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_title_size_mobile",
      "label": "Kachel Titel Größe Mobile",
      "min": 18,
      "max": 34,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_title_size_desktop",
      "label": "Kachel Titel Größe Desktop",
      "min": 18,
      "max": 38,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "card_text_size_mobile",
      "label": "Kachel Text Größe Mobile",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_text_size_desktop",
      "label": "Kachel Text Größe Desktop",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Bildhöhe Mobile",
      "min": 220,
      "max": 620,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Bildhöhe Desktop",
      "min": 260,
      "max": 720,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Layout & Abstände"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 900,
      "max": 1700,
      "step": 20,
      "unit": "px",
      "default": 1500
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding oben Mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding unten Mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding oben Desktop",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 92
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding unten Desktop",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 92
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt-Kachel",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "1. Einschalten"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Beschreibung",
          "default": "<p>Sanfte Wärme in kurzer Zeit bereit.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Bild Alt Text",
          "default": "SEREN SoftTouch Anwendung"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "SEREN Steps V1",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "1. Einschalten",
            "description": "<p>Sanfte Wärme in kurzer Zeit bereit.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "2. Nachformen",
            "description": "<p>Sanft durch Frizz, Spitzen oder platte Partien führen.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "3. Fertig",
            "description": "<p>Ruhigeres Haar — ohne komplettes Styling.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
