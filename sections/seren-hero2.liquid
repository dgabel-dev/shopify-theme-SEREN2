{% liquid
  assign desktop_image = section.settings.hero_image
  assign mobile_image = section.settings.mobile_image

  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
%}

<section
  id="seren-hero-{{ section.id }}"
  class="seren-hero"
  style="
    --seren-bg: {{ section.settings.background_color }};
    --seren-text: {{ section.settings.text_color }};
    --seren-muted: {{ section.settings.muted_text_color }};
    --seren-accent: {{ section.settings.accent_color }};
    --seren-card-bg: {{ section.settings.quote_card_background }};
    --seren-card-text: {{ section.settings.quote_card_text_color }};
    --seren-button-bg: {{ section.settings.button_background_color }};
    --seren-button-text: {{ section.settings.button_text_color }};
    --seren-border: {{ section.settings.border_color }};
    --seren-max-width: {{ section.settings.max_width }}px;
    --seren-mobile-padding-x: {{ section.settings.mobile_padding_x }}px;
    --seren-desktop-padding-x: {{ section.settings.desktop_padding_x }}px;
    --seren-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --seren-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --seren-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --seren-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --seren-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --seren-content-top-mobile: {{ section.settings.content_top_mobile }}%;
    --seren-content-max-width-mobile: {{ section.settings.content_max_width_mobile }}px;
    --seren-content-max-width-desktop: {{ section.settings.content_max_width_desktop }}px;
    --seren-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --seren-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --seren-subheading-mobile: {{ section.settings.subheading_size_mobile }}px;
    --seren-subheading-desktop: {{ section.settings.subheading_size_desktop }}px;
    --seren-eyebrow-mobile: {{ section.settings.eyebrow_size_mobile }}px;
    --seren-eyebrow-desktop: {{ section.settings.eyebrow_size_desktop }}px;
    --seren-price-size-mobile: {{ section.settings.price_size_mobile }}px;
    --seren-price-size-desktop: {{ section.settings.price_size_desktop }}px;
    --seren-button-size: {{ section.settings.button_font_size }}px;
    --seren-button-radius: {{ section.settings.button_border_radius }}px;
    --seren-button-padding-y: {{ section.settings.button_padding_y }}px;
    --seren-button-padding-x: {{ section.settings.button_padding_x }}px;
    --seren-trust-icon-size: {{ section.settings.trust_icon_size }}px;
  "
>
  <div class="seren-hero__shell">
    <div class="seren-hero__image-wrap">
      {% if desktop_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 480 }} 480w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 960 }} 960w,
                {{ mobile_image | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
            >
          {% endif %}
          <img
            class="seren-hero__image"
            src="{{ desktop_image | image_url: width: 1600 }}"
            srcset="
              {{ desktop_image | image_url: width: 750 }} 750w,
              {{ desktop_image | image_url: width: 1100 }} 1100w,
              {{ desktop_image | image_url: width: 1600 }} 1600w,
              {{ desktop_image | image_url: width: 2200 }} 2200w
            "
            sizes="(max-width: 749px) 100vw, min(100vw, {{ section.settings.max_width }}px)"
            alt="{{ section.settings.image_alt | escape }}"
            width="{{ desktop_image.width }}"
            height="{{ desktop_image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        </picture>
      {% else %}
        <div class="seren-hero__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'seren-hero__placeholder-svg' }}
        </div>
      {% endif %}

      <div class="seren-hero__overlay" aria-hidden="true"></div>

      {% if section.settings.show_quote_card %}
        <div class="seren-hero__quote seren-hero__quote--{{ section.settings.quote_card_position }}">
          <span class="seren-hero__quote-mark">“</span>
          <span class="seren-hero__quote-text">{{ section.settings.quote_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.show_product_cutout and section.settings.product_image != blank %}
        <div class="seren-hero__product seren-hero__product--{{ section.settings.product_position }}">
          <img
            class="seren-hero__product-image"
            src="{{ section.settings.product_image | image_url: width: 700 }}"
            srcset="
              {{ section.settings.product_image | image_url: width: 320 }} 320w,
              {{ section.settings.product_image | image_url: width: 520 }} 520w,
              {{ section.settings.product_image | image_url: width: 700 }} 700w
            "
            sizes="(max-width: 749px) {{ section.settings.product_width_mobile }}vw, {{ section.settings.product_width_desktop }}px"
            alt="{{ section.settings.product_image_alt | escape }}"
            width="{{ section.settings.product_image.width }}"
            height="{{ section.settings.product_image.height }}"
            loading="eager"
          >
        </div>
      {% endif %}
    </div>

    <div class="seren-hero__content seren-hero__content--mobile-{{ section.settings.mobile_text_alignment }} seren-hero__content--desktop-{{ section.settings.desktop_text_alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="seren-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="seren-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="seren-hero__subheading">{{ section.settings.subheading }}</div>
      {% endif %}

      {% if section.settings.show_rating %}
        <div class="seren-hero__rating" aria-label="{{ section.settings.rating_text | escape }}">
          <span class="seren-hero__stars" aria-hidden="true">★★★★★</span>
          <span class="seren-hero__rating-text">{{ section.settings.rating_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.price_text != blank %}
        <div class="seren-hero__price">{{ section.settings.price_text }}</div>
      {% endif %}

      {% if section.settings.tax_shipping_text != blank %}
        <div class="seren-hero__tax">{{ section.settings.tax_shipping_text }}</div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a class="seren-hero__button" href="{{ section.settings.button_link | default: '#' }}">
          <span>{{ section.settings.button_text }}</span>
          {% if section.settings.show_button_arrow %}
            <span class="seren-hero__button-arrow" aria-hidden="true">›</span>
          {% endif %}
        </a>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="seren-hero__trust-grid" aria-label="Trust benefits">
          {% for block in section.blocks %}
            <div class="seren-hero__trust-item" {{ block.shopify_attributes }}>
              <div class="seren-hero__trust-icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'calendar' %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M7 3v3M17 3v3M4.5 9.5h15M6.5 5h11A2.5 2.5 0 0 1 20 7.5v11A2.5 2.5 0 0 1 17.5 21h-11A2.5 2.5 0 0 1 4 18.5v-11A2.5 2.5 0 0 1 6.5 5Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 14h.01M12 14h.01M16 14h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                  {% when 'truck' %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M3 6.5h11v10H3v-10ZM14 10h3.2l3.8 3.5v3H14V10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.6"/></svg>
                  {% when 'shield' %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5 19 6v5.5c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V6l7-2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m8.8 12.2 2 2 4.5-4.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% when 'heart' %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 20s-7.5-4.4-7.5-10.1A4.2 4.2 0 0 1 12 7.2a4.2 4.2 0 0 1 7.5 2.7C19.5 15.6 12 20 12 20Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% endcase %}
              </div>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #seren-hero-{{ section.id }} {
    background: var(--seren-bg);
    color: var(--seren-text);
    padding: var(--seren-padding-top-mobile) var(--seren-mobile-padding-x) var(--seren-padding-bottom-mobile);
    overflow: hidden;
  }

  #seren-hero-{{ section.id }} .seren-hero__shell {
    width: 100%;
    max-width: var(--seren-max-width);
    margin: 0 auto;
    position: relative;
    border-radius: {{ section.settings.hero_border_radius_mobile }}px;
    overflow: hidden;
    background: var(--seren-bg);
    min-height: {{ section.settings.mobile_min_height }}px;
  }

  #seren-hero-{{ section.id }} .seren-hero__image-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #seren-hero-{{ section.id }} .seren-hero__image,
  #seren-hero-{{ section.id }} .seren-hero__placeholder,
  #seren-hero-{{ section.id }} picture {
    width: 100%;
    height: 100%;
    display: block;
  }

  #seren-hero-{{ section.id }} .seren-hero__image {
    object-fit: cover;
    object-position: {{ section.settings.mobile_image_position }};
  }

  #seren-hero-{{ section.id }} .seren-hero__placeholder {
    min-height: inherit;
    background: linear-gradient(135deg, #f6eee3, #e8d8c5);
  }

  #seren-hero-{{ section.id }} .seren-hero__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }

  #seren-hero-{{ section.id }} .seren-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0.05) 40%, rgba(247,241,232,var(--seren-overlay-opacity)) 66%, var(--seren-bg) 100%),
      linear-gradient(to right, rgba(247,241,232,0.18), rgba(247,241,232,0));
  }

  #seren-hero-{{ section.id }} .seren-hero__quote {
    position: absolute;
    z-index: 3;
    max-width: {{ section.settings.quote_card_width_mobile }}px;
    padding: {{ section.settings.quote_card_padding_mobile }}px;
    border-radius: {{ section.settings.quote_card_radius }}px;
    background: color-mix(in srgb, var(--seren-card-bg) {{ section.settings.quote_card_opacity }}%, transparent);
    color: var(--seren-card-text);
    box-shadow: 0 12px 38px rgba(36, 25, 21, 0.08);
    backdrop-filter: blur(8px);
  }

  #seren-hero-{{ section.id }} .seren-hero__quote--left {
    left: {{ section.settings.quote_card_left_mobile }}%;
    top: {{ section.settings.quote_card_top_mobile }}%;
  }

  #seren-hero-{{ section.id }} .seren-hero__quote--right {
    right: {{ section.settings.quote_card_left_mobile }}%;
    top: {{ section.settings.quote_card_top_mobile }}%;
  }

  #seren-hero-{{ section.id }} .seren-hero__quote-mark {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: {{ section.settings.quote_mark_size }}px;
    line-height: 0.7;
    color: var(--seren-accent);
    margin-bottom: 8px;
  }

  #seren-hero-{{ section.id }} .seren-hero__quote-text {
    display: block;
    font-size: {{ section.settings.quote_text_size_mobile }}px;
    line-height: 1.28;
    letter-spacing: -0.01em;
  }

  #seren-hero-{{ section.id }} .seren-hero__product {
    position: absolute;
    z-index: 4;
    width: {{ section.settings.product_width_mobile }}vw;
    max-width: {{ section.settings.product_max_width_mobile }}px;
    filter: drop-shadow(0 18px 32px rgba(36, 25, 21, 0.16));
  }

  #seren-hero-{{ section.id }} .seren-hero__product--right {
    right: {{ section.settings.product_right_mobile }}%;
    bottom: {{ section.settings.product_bottom_mobile }}%;
  }

  #seren-hero-{{ section.id }} .seren-hero__product--left {
    left: {{ section.settings.product_right_mobile }}%;
    bottom: {{ section.settings.product_bottom_mobile }}%;
  }

  #seren-hero-{{ section.id }} .seren-hero__product-image {
    display: block;
    width: 100%;
    height: auto;
  }

  #seren-hero-{{ section.id }} .seren-hero__content {
    position: relative;
    z-index: 5;
    max-width: var(--seren-content-max-width-mobile);
    padding: {{ section.settings.content_padding_top_mobile }}px {{ section.settings.content_padding_x_mobile }}px {{ section.settings.content_padding_bottom_mobile }}px;
    min-height: {{ section.settings.mobile_min_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  #seren-hero-{{ section.id }} .seren-hero__content--mobile-left {
    text-align: left;
    align-items: flex-start;
  }

  #seren-hero-{{ section.id }} .seren-hero__content--mobile-center {
    text-align: center;
    align-items: center;
    margin-inline: auto;
  }

  #seren-hero-{{ section.id }} .seren-hero__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_margin_bottom }}px;
    font-size: var(--seren-eyebrow-mobile);
    line-height: 1.2;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}em;
    font-weight: 400;
    color: var(--seren-text);
  }

  #seren-hero-{{ section.id }} .seren-hero__heading {
    margin: 0;
    max-width: {{ section.settings.heading_max_width_mobile }}px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--seren-heading-mobile);
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    letter-spacing: -0.045em;
    font-weight: 400;
    color: var(--seren-text);
  }

  #seren-hero-{{ section.id }} .seren-hero__subheading {
    max-width: {{ section.settings.subheading_max_width_mobile }}px;
    margin-top: {{ section.settings.subheading_margin_top }}px;
    color: var(--seren-muted);
    font-size: var(--seren-subheading-mobile);
    line-height: {{ section.settings.subheading_line_height | divided_by: 100.0 }};
    letter-spacing: -0.015em;
  }

  #seren-hero-{{ section.id }} .seren-hero__subheading p {
    margin: 0;
  }

  #seren-hero-{{ section.id }} .seren-hero__rating {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: {{ section.settings.rating_margin_top }}px;
    color: var(--seren-text);
    font-size: {{ section.settings.rating_font_size }}px;
    line-height: 1.2;
  }

  #seren-hero-{{ section.id }} .seren-hero__content--mobile-center .seren-hero__rating {
    justify-content: center;
  }

  #seren-hero-{{ section.id }} .seren-hero__stars {
    color: var(--seren-accent);
    letter-spacing: 0.08em;
    font-size: {{ section.settings.star_size }}px;
  }

  #seren-hero-{{ section.id }} .seren-hero__price {
    margin-top: {{ section.settings.price_margin_top }}px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--seren-price-size-mobile);
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--seren-text);
  }

  #seren-hero-{{ section.id }} .seren-hero__tax {
    margin-top: 8px;
    color: var(--seren-muted);
    font-size: {{ section.settings.tax_font_size }}px;
    line-height: 1.3;
  }

  #seren-hero-{{ section.id }} .seren-hero__button {
    width: 100%;
    margin-top: {{ section.settings.button_margin_top }}px;
    min-height: {{ section.settings.button_min_height }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: var(--seren-button-padding-y) var(--seren-button-padding-x);
    border-radius: var(--seren-button-radius);
    background: var(--seren-button-bg);
    color: var(--seren-button-text);
    font-size: var(--seren-button-size);
    line-height: 1;
    letter-spacing: {{ section.settings.button_letter_spacing }}em;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 18px 36px rgba(36, 25, 21, 0.14);
    transition: transform 180ms ease, opacity 180ms ease, box-shadow 180ms ease;
  }

  #seren-hero-{{ section.id }} .seren-hero__button:hover {
    color: var(--seren-button-text);
    opacity: 0.96;
    transform: translateY(-1px);
    box-shadow: 0 22px 42px rgba(36, 25, 21, 0.18);
  }

  #seren-hero-{{ section.id }} .seren-hero__button-arrow {
    font-size: 1.35em;
    line-height: 0.8;
    font-weight: 300;
    transform: translateY(-1px);
  }

  #seren-hero-{{ section.id }} .seren-hero__trust-grid {
    width: 100%;
    margin-top: {{ section.settings.trust_margin_top }}px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.trust_columns_mobile }}, minmax(0, 1fr));
    border: 1px solid var(--seren-border);
    border-radius: {{ section.settings.trust_radius }}px;
    background: rgba(255, 255, 255, {{ section.settings.trust_background_opacity | divided_by: 100.0 }});
    overflow: hidden;
  }

  #seren-hero-{{ section.id }} .seren-hero__trust-item {
    min-height: {{ section.settings.trust_min_height }}px;
    padding: {{ section.settings.trust_padding_y }}px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--seren-text);
    text-align: center;
  }

  #seren-hero-{{ section.id }} .seren-hero__trust-item + .seren-hero__trust-item {
    border-left: 1px solid var(--seren-border);
  }

  #seren-hero-{{ section.id }} .seren-hero__trust-icon {
    width: var(--seren-trust-icon-size);
    height: var(--seren-trust-icon-size);
    color: var(--seren-text);
  }

  #seren-hero-{{ section.id }} .seren-hero__trust-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #seren-hero-{{ section.id }} .seren-hero__trust-item p {
    margin: 0;
    color: var(--seren-text);
    font-size: {{ section.settings.trust_font_size }}px;
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  @media screen and (min-width: 750px) {
    #seren-hero-{{ section.id }} {
      padding: var(--seren-padding-top-desktop) var(--seren-desktop-padding-x) var(--seren-padding-bottom-desktop);
    }

    #seren-hero-{{ section.id }} .seren-hero__shell {
      min-height: {{ section.settings.desktop_min_height }}px;
      border-radius: {{ section.settings.hero_border_radius_desktop }}px;
    }

    #seren-hero-{{ section.id }} .seren-hero__image {
      object-position: {{ section.settings.desktop_image_position }};
    }

    #seren-hero-{{ section.id }} .seren-hero__overlay {
      background:
        linear-gradient(to right, var(--seren-bg) 0%, rgba(247,241,232,0.84) 25%, rgba(247,241,232,0.28) 54%, rgba(247,241,232,0.04) 100%),
        linear-gradient(to top, rgba(247,241,232,0.28), rgba(247,241,232,0));
    }

    #seren-hero-{{ section.id }} .seren-hero__content {
      max-width: var(--seren-content-max-width-desktop);
      min-height: {{ section.settings.desktop_min_height }}px;
      padding: {{ section.settings.content_padding_top_desktop }}px {{ section.settings.content_padding_x_desktop }}px {{ section.settings.content_padding_bottom_desktop }}px;
    }

    #seren-hero-{{ section.id }} .seren-hero__content--desktop-left {
      text-align: left;
      align-items: flex-start;
      margin: 0;
    }

    #seren-hero-{{ section.id }} .seren-hero__content--desktop-center {
      text-align: center;
      align-items: center;
      margin: 0 auto;
    }

    #seren-hero-{{ section.id }} .seren-hero__eyebrow {
      font-size: var(--seren-eyebrow-desktop);
    }

    #seren-hero-{{ section.id }} .seren-hero__heading {
      max-width: {{ section.settings.heading_max_width_desktop }}px;
      font-size: var(--seren-heading-desktop);
    }

    #seren-hero-{{ section.id }} .seren-hero__subheading {
      max-width: {{ section.settings.subheading_max_width_desktop }}px;
      font-size: var(--seren-subheading-desktop);
    }

    #seren-hero-{{ section.id }} .seren-hero__price {
      font-size: var(--seren-price-size-desktop);
    }

    #seren-hero-{{ section.id }} .seren-hero__button {
      width: auto;
      min-width: {{ section.settings.button_min_width_desktop }}px;
    }

    #seren-hero-{{ section.id }} .seren-hero__trust-grid {
      max-width: {{ section.settings.trust_max_width_desktop }}px;
      grid-template-columns: repeat({{ section.settings.trust_columns_desktop }}, minmax(0, 1fr));
    }

    #seren-hero-{{ section.id }} .seren-hero__quote {
      max-width: {{ section.settings.quote_card_width_desktop }}px;
      padding: {{ section.settings.quote_card_padding_desktop }}px;
    }

    #seren-hero-{{ section.id }} .seren-hero__quote--left {
      left: {{ section.settings.quote_card_left_desktop }}%;
      top: {{ section.settings.quote_card_top_desktop }}%;
    }

    #seren-hero-{{ section.id }} .seren-hero__quote--right {
      right: {{ section.settings.quote_card_left_desktop }}%;
      top: {{ section.settings.quote_card_top_desktop }}%;
    }

    #seren-hero-{{ section.id }} .seren-hero__quote-text {
      font-size: {{ section.settings.quote_text_size_desktop }}px;
    }

    #seren-hero-{{ section.id }} .seren-hero__product {
      width: {{ section.settings.product_width_desktop }}px;
      max-width: none;
    }

    #seren-hero-{{ section.id }} .seren-hero__product--right {
      right: {{ section.settings.product_right_desktop }}%;
      bottom: {{ section.settings.product_bottom_desktop }}%;
    }

    #seren-hero-{{ section.id }} .seren-hero__product--left {
      left: {{ section.settings.product_right_desktop }}%;
      bottom: {{ section.settings.product_bottom_desktop }}%;
    }
  }
