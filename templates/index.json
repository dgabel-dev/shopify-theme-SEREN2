    "seren_faq_v2_UV3mqQ": {
      "type": "seren-faq-v2",
      "blocks": {
        "faq_item_7cXHXz": {
          "type": "faq_item",
          "settings": {
            "question": "Ist SEREN SoftTouch für feines Haar geeignet?",
            "answer": "<p>Ja. SEREN SoftTouch ist besonders für schnelle Touch-Ups bei feinerem Haar, Frizz und kleinen Partien gedacht, die morgens nicht richtig sitzen.</p>"
          }
        },
        "faq_item_CedRRL": {
          "type": "faq_item",
          "settings": {
            "question": "Ist SEREN ein Glätteisen?",
            "answer": "<p>Nein. SEREN ist kein klassisches Glätteisen, sondern ein Soft-Heat Touch-Up Comb für sanftes Nachformen kleiner Haarpartien.</p>"
          }
        },
        "faq_item_PbQ8MD": {
          "type": "faq_item",
          "settings": {
            "question": "Macht SEREN mein Haar platt?",
            "answer": "<p>Nein. Die Anwendung ist für gezielte Partien gedacht, damit das Haar ruhiger und gepflegter fällt, ohne komplett platt gestylt zu wirken.</p>"
          }
        },
        "faq_item_VrGf7x": {
          "type": "faq_item",
          "settings": {
            "question": "Kann ich SEREN täglich benutzen?",
            "answer": "<p>Ja, für kurze morgendliche Touch-Ups auf trockenem Haar. Bitte beachte immer die Anwendungshinweise deines Produkts.</p>"
          }
        },
        "faq_item_tfBAjN": {
          "type": "faq_item",
          "settings": {
            "question": "Für welche Frisuren ist SEREN ideal?",
            "answer": "<p>Besonders praktisch ist SEREN für Bob, Lob, mittellanges Haar, Spitzen, Seitenpartien und sichtbaren Frizz.</p>"
          }
        },
        "faq_item_cqHLtw": {
          "type": "faq_item",
          "settings": {
            "question": "Kann ich SEREN unterwegs nutzen?",
            "answer": "<p>Ja. Durch das kabellose Format eignet sich SEREN auch für schnelle Touch-Ups unterwegs oder auf Reisen.</p>"
          }
        },
        "faq_item_gdtrrx": {
          "type": "faq_item",
          "settings": {
            "question": "Auf trockenem oder nassem Haar anwenden?",
            "answer": "<p>Am besten auf trockenem Haar verwenden. Nicht auf nassem Haar anwenden, sofern die Produktanleitung nichts anderes sagt.</p>"
          }
        },
        "faq_item_8HaY4G": {
          "type": "faq_item",
          "settings": {
            "question": "Für welche Probleme ist SEREN gedacht?",
            "answer": "<p>Für sichtbaren Frizz, platte Partien, unruhige Spitzen und kleine Haarstellen, die morgens einfach nicht sitzen wollen.</p>"
          }
        }
      },
